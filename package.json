{
  "name": "covault-v3",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "typecheck:unused": "tsc --noEmit --noUnusedLocals --noUnusedParameters",
    "lint": "eslint . --max-warnings=0",
    "verify": "npm run check:structure && npm run typecheck && npm run typecheck:unused && npm run lint && npm test && npm run build",
    "cap:sync": "cap sync android && bash scripts/sync-android.sh",
    "cap:build": "npm run build && cap sync android && bash scripts/sync-android.sh",
    "check:structure": "node scripts/check-react-structure.mjs"
  },
  "dependencies": {
